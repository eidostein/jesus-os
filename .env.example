# Hey Jesus — environment configuration
# Copy to .env and fill in real values. Never commit .env.

# Comma-separated pool of Gemini API keys. The server rotates across them
# and skips over keys that hit quota/rate limits.
GEMINI_API_KEYS=your-key-1,your-key-2

# Gemini Live model used for voice conversations.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Default prebuilt voice (users can pick any voice on the homepage).
DEFAULT_VOICE=Algieba

# Port the app server listens on (Caddy proxies to this inside Docker).
PORT=8790

# ── /os dashboard ────────────────────────────────────────────────────────────
# bcrypt hash for the /os basic-auth user "jesus". Generate with:
#   docker run --rm caddy caddy hash-password
OS_DASH_HASH=

# Host directory holding the LIVE knowledge files (Knowledge-tab edits land
# here and survive deploys). Defaults to ./knowledge for local development;
# on the server set an out-of-repo path, e.g. /opt/hey-jesus-data/knowledge
KNOWLEDGE_HOST_DIR=./knowledge
